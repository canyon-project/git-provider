# GitLab HTTP API（含 /api/v4 后缀）
DEBUG_GITLAB_BASE=https://gitlab.example.com/api/v4
DEBUG_GITLAB_TOKEN=
# 项目 ID（数字）或 URL 编码路径，如 my-group/my-repo
DEBUG_GITLAB_PROJECT=my-group/my-repo

DEBUG_COMPARE_BASE_SHA=
DEBUG_COMPARE_HEAD_SHA=

# 拉取源码的 ref；留空则使用 DEBUG_COMPARE_HEAD_SHA
DEBUG_SOURCE_SHA=

# 逗号分隔；留空则拉取该 ref 下全部文件（与 getSourceFiles([]) 行为一致）
DEBUG_SOURCE_FILE_PATHS=
